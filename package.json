{
	"name": "kanban",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
		"build": "node scripts/build.ts",
		"dev": "npm run build && KANBAN_AUTH=off node --watch src/server/main.ts",
		"start": "node src/server/main.ts",
		"check": "tsc --noEmit && biome check . && node --test",
		"test": "node --test"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@preact/signals": "^2.11.3",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"jose": "^6.2.13",
		"lucide-preact": "^1.61.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-gfm": "^3.1.0",
		"micromark-extension-gfm": "^3.0.0",
		"node-pty": "^1.1.0",
		"preact": "^11.0.1",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.5",
		"@types/ws": "^8.18.2",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
